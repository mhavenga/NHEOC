package jp.co.vantiq
stateless PROCEDURE AuditLogManager.buildAgentOutputLog(
	incidentId     String REQUIRED, 
	agentName      String REQUIRED, 
	outputSnapshot Any    REQUIRED
): Object
var log = {
	"incident_id"    : incidentId,
	"event_type"     : "agent",
	"agent_name"     : agentName,
	"output_snapshot": stringify(outputSnapshot),
	"created_at"     : now()
}
return log