package jp.co.vantiq
stateless PROCEDURE ActionAgent.notifyLevel2Targets(incident Object REQUIRED): Object
//log.info("Sent notification to Level 2 targets")
var response = ActionAgent.notifyIncident(
	channelName     : "level2", 
	incidentDetails : incident
)
return {
	"response": "Notification sent to #level2, Response=" + response
}