try {
    SELECT * FROM SOURCE NHEOC_SQL AS results WITH
    query: "SELECT TOP (10) * FROM [NHEOC-AI02].[dbo].[table_6]"
	
	return results
} catch (error) {
    exception(error.code, error.message)
}