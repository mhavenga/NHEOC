package jp.co.vantiq
stateless PROCEDURE ActionAgent.notifyLevel4Targets(incident Object REQUIRED): Object
log.info("Sent notification to Level 4 targets")
var response = ActionAgent.notifyIncident(
	channelName     : "level4", 
	incidentDetails : incident
)
return {
	"response": "Notification sent to #level4, Response=" + response
}