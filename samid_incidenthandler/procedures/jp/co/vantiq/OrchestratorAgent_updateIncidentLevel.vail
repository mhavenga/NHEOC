package jp.co.vantiq
stateless PROCEDURE OrchestratorAgent.updateIncidentLevel(incidentId       String REQUIRED,  
	suggestedLevel    Integer,
	incidentLevel Integer,
	patientRatio Integer, 
	notes String
): Object

var prevLevel = select one suggested_level FROM jp.co.vantiq.incident_statuses
where incident_id  == incidentId  


var incidentStatus = {
	"incident_id": incidentId
}

if (prevLevel != null){
	if (prevLevel.suggested_level == "Evaluating..."){
		incidentStatus.suggested_level = suggestedLevel
		incidentStatus.incident_level = incidentLevel
		incidentStatus.evaluatedLevel = suggestedLevel
	}else{
		incidentStatus.evaluatedLevel = suggestedLevel
		if (toInteger(incidentStatus.evaluatedLevel) > toInteger(prevLevel.suggested_level)){
			incidentStatus.ActionRequired = "Esculate"	
		}else if (toInteger(incidentStatus.evaluatedLevel) < toInteger(prevLevel.suggested_level)) {
			incidentStatus.ActionRequired = "De-Esculate"	
		}
		
	}
	
	if (patientRatio != null) {
		incidentStatus.patientRatio = patientRatio
	}

	UPSERT incident_statuses(incidentStatus)
}


return incidentStatus