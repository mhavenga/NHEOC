package jp.co.vantiq
import service Utils
stateless PROCEDURE utils.getIncidentNotifications(In_incident_id)

var qResult = select createdAt,  messageBody, notificationType from jp.co.vantiq.notifications
where incidentId == In_incident_id
order by createdAt

//for (q in qResult){
//	q = Utils.stripSystemProperties(q)
//}

return qResult

